<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryDiskSpace</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <!-- E174.1: 写入文件前检查剩余磁盘空间以避免写入失败 -->
                <string>E174.1</string>
            </array>
        </dict>
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>C617.1</string>
            </array>
        </dict>
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategorySystemBootTime</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <!-- 35F9.1: 测量 app 内事件间经过的时间（用于计时器等） -->
                <string>35F9.1</string>
            </array>
        </dict>
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>CA92.1</string>
            </array>
        </dict>
    </array>

    <key>NSPrivacyCollectedDataTypes</key>
    <array/>

    <key>NSPrivacyTracking</key>
    <false/>

    <key>NSPrivacyThirdPartySDKs</key>
    <array>
        <dict>
            <key>NSPrivacyThirdPartySDKIdentifier</key>
            <string>com.afnetworking.afnetworking</string>
        </dict>
        <dict>
            <key>NSPrivacyThirdPartySDKIdentifier</key>
            <string>com.sdwebimage.sdwebimage</string>
        </dict>
        <dict>
            <key>NSPrivacyThirdPartySDKIdentifier</key>
            <string>com.fmdb.fmdb</string>
        </dict>
        <dict>
            <key>NSPrivacyThirdPartySDKIdentifier</key>
            <string>com.mbprogresshud.mbprogresshud</string>
        </dict>
        <dict>
            <key>NSPrivacyThirdPartySDKIdentifier</key>
            <string>com.starscream.starscream</string>
        </dict>
        <dict>
            <key>NSPrivacyThirdPartySDKIdentifier</key>
            <string>com.toast.toast</string>
        </dict>
    </array>
</dict>
</plist>
